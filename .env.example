# Node
TZ=UTC
PORT=3333
HOST=localhost
# En Docker / Coolify : HOST=0.0.0.0
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}
VITE_APP_NAME=Mémoire
# En Coolify, APP_KEY et APP_URL sont générés au démarrage s'ils manquent.
# Pour un domaine public, définis APP_URL=https://ton-domaine.tld

# Session
SESSION_DRIVER=cookie

# SQLite. Vide en local (fichier dans tmp/). En Docker : /data/db.sqlite3
# Ce dossier doit être un volume persistant, sinon la base est vide à chaque déploiement.
# SQLITE_DB_PATH=/data/db.sqlite3